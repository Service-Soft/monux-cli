{
    "name": "{{=packageName}}",
    "version": "0.0.0",
    "private": true,
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/cjs/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/cjs/index.d.ts",
            "node": "./dist/cjs/index.js",
            "default": "./dist/esm/index.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -b tsconfig.cjs.json tsconfig.esm.json",
        "start": "tsc -b tsconfig.cjs.json tsconfig.esm.json --watch --preserveWatchOutput"
    }
}
